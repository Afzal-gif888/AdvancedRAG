# AdvancedRAG Agent Core — copy to agent-core/.env. Holds no provider keys.

ENVIRONMENT=development
INTERNAL_SERVICE_TOKEN=

RAG_CORE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003

# Routing hints passed to the LLM layer. Empty = the LLM layer's FREELLMAPI_MODEL.
AGENT_MODEL=
# Used for cheap steps (follow-up rewrites, evidence grading, query correction, answer
# verification, table query planning). Must be a model id
# your gateway lists at GET /v1/models; empty = the LLM layer's default.
AGENT_FAST_MODEL=
AGENT_TEMPERATURE=0.3
AGENT_MAX_OUTPUT_TOKENS=
QUERY_REWRITE_ENABLED=true
RETRIEVAL_TOP_K=6

# Strictly grounded, self-correcting RAG (docs/agent-core-architecture.md section 7).
EVIDENCE_GRADING_ENABLED=true
ANSWER_VERIFICATION_ENABLED=true
TABLE_ANALYSIS_ENABLED=true
MAX_CORRECTION_ATTEMPTS=1
CHECK_TIMEOUT_SECONDS=30

RAG_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
