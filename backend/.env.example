# AdvancedRAG backend — copy to backend/.env. Never commit real values.
# The backend holds NO model-provider keys (no FreeLLMAPI / Pinecone): those belong to
# llm/ and rag-core/.

# Required. development | staging | production. Staging/production refuse to start with unsafe
# settings (weak secrets, SQLite, wildcard CORS, missing Redis/email/storage/service token...).
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# Local docker:  docker compose up -d   (see ../.env for POSTGRES_PASSWORD / POSTGRES_PORT)
# Use 127.0.0.1 rather than localhost on Windows (avoids a slow IPv6 attempt per connection).
DATABASE_URL=postgresql+asyncpg://advancerag:CHANGE_ME@127.0.0.1:5434/advancerag

# --- Auth --- generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Concurrent refreshes from tabs of one browser within this window are not treated as token theft.
REFRESH_REUSE_GRACE_SECONDS=30


# Refresh cookie. COOKIE_SECURE defaults to true outside development.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Frontend / CORS --- comma-separated allowlist, never "*"
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PUBLIC_URL=
# Proxies you control in front of the backend (0 local, 1 Railway, 2 Vercel rewrite + Railway).
TRUSTED_PROXY_HOPS=0

# --- Internal services ---
AGENT_CORE_URL=http://localhost:8001
RAG_CORE_URL=http://localhost:8002
# Shared secret for service-to-service calls (same value in agent-core, rag-core, llm).
# Required (>= 32 chars) outside development.
INTERNAL_SERVICE_TOKEN=
# /ready also requires Agent Core + RAG Core (default: on outside development).
READINESS_REQUIRE_SERVICES=

# --- Storage --- local disk for development; s3 (AWS S3 / Cloudflare R2 / MinIO / SeaweedFS) or db (blob in the
# application database, atomic with the job) for anything that must survive restarts. Each document records the
# backend that holds it, so switching later does not orphan existing files.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=var/storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
STORAGE_ENDPOINT=
STORAGE_REGION=

STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Uploads --- (add png,jpg,jpeg only if RAG Core runs with OCR_ENABLED=true)
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,md,csv,docx
MAX_DOCUMENTS_PER_USER=500

# --- Background worker (runs inside the API process) ---
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
DELETE_JOB_MAX_ATTEMPTS=6
RECONCILE_INTERVAL_SECONDS=600
STALE_GENERATION_SECONDS=600

# --- Rate limiting --- memory = per process (development); redis required outside development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# --- Email --- only used to send password-reset links (sign-up and login never send email).
# Production (Railway *backend* variables only — never a VITE_* variable, never committed):
#   EMAIL_PROVIDER=resend
#   EMAIL_API_KEY=<your Resend API key>        (secret: set it in the host's variables, not here)
#   EMAIL_FROM=AdvancedRAG <no-reply@mail.example.com>   (domain verified in Resend)
#   FRONTEND_PUBLIC_URL=https://<your frontend>             (reset links: <url>/reset-password?token=...)
# Other providers:
#   smtp   : any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
#            SMTP_USERNAME=<your gmail>, SMTP_PASSWORD=<16-char Google *app password*>
#            (Google account -> Security -> 2-Step Verification -> App passwords), EMAIL_FROM=<same gmail>
#   mock   : automated tests only (recorded in memory, never sent)
#   empty  : development -> reset emails are written to backend/var/outbox/ (no Resend key needed);
#            elsewhere nothing is sent (forgot-password then cannot deliver a link; a warning is logged)
# Staging/production refuse to start with resend/smtp misconfigured, with mock/file, with a
# localhost EMAIL_FROM, or with a non-https frontend URL.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
