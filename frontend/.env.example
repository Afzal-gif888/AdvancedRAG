# Frontend configuration. Everything here is PUBLIC: Vite inlines VITE_* values into the browser
# bundle. Never put API keys or secrets in this file (FreeLLMAPI/Pinecone keys belong to
# the server-side services only).

# Base URL of the backend API as seen by the browser.
# Leave empty for the default "/api/v1" (same origin; the Vite dev server proxies /api).
VITE_API_BASE_URL=

# Dev-server only (not shipped to the browser): where the Vite proxy forwards /api.
VITE_API_PROXY_TARGET=http://localhost:8000
