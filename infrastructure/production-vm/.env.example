# Compose-level settings for the single-VM deployment. Copy to .env (git-ignored, chmod 600).
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public HTTPS hostname of the API; its DNS A/AAAA record must point at this VM.
API_DOMAIN=api.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=you@example.com
# Shared by backend, agent-core, rag-core and llm (>= 32 random characters).
INTERNAL_SERVICE_TOKEN=
# Redis password (private network only).
REDIS_PASSWORD=
