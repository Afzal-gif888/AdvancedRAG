# Backend secrets and settings. Copy to backend.env (git-ignored).
# Neon POOLED connection string for database "advancerag" (host contains -pooler), with sslmode=require.
DATABASE_URL=
# Two different random values, >= 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
# The web app's origin (Vercel custom domain on the same site as API_DOMAIN, e.g. https://app.example.com).
FRONTEND_ORIGIN=
FRONTEND_PUBLIC_URL=
# Direct mode: browser -> Caddy -> backend. Caddy sets X-Forwarded-For itself, so 1 hop is exact.
TRUSTED_PROXY_HOPS=1

# Uploaded files. Either a persistent Docker volume on this VM (back it up) ...
STORAGE_BACKEND=local
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
# ... or Cloudflare R2 / S3 (then remove the two lines above):
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Password-reset e-mail. Empty = disabled. Resend needs EMAIL_API_KEY and a verified sender domain.
EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=AdvancedRAG <no-reply@your-verified-domain>
