# FreeLLMAPI. Copy to freellmapi.env (git-ignored). Set BEFORE the first start.
# 64 hex characters; never change it later (it encrypts the stored provider keys):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
# Creates the dashboard admin before the server listens, so nobody else can claim it.
FREEAPI_CONFIG_JSON={"admin":{"email":"you@example.com","password":"<strong password>"}}
