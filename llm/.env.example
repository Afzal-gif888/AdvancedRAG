# AdvancedRAG LLM layer — copy to llm/.env. This is the ONLY place the FreeLLMAPI key lives.
# Never put it in frontend/.env or any VITE_* variable. Provider keys (OpenRouter, Groq, ...)
# live inside FreeLLMAPI, never here. See docs/production-freellmapi.md.

ENVIRONMENT=development
# Same shared secret as the other services (required >= 32 chars outside development).
INTERNAL_SERVICE_TOKEN=

LLM_PROVIDER=freellmapi

# ---- Local development: the FreeLLMAPI desktop app (empty = http://127.0.0.1:31415/v1).
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
# ---- Production (ENVIRONMENT=production): REQUIRED, must be HTTPS and not localhost:
# FREELLMAPI_BASE_URL=https://<your-hosted-freellmapi>/v1
# The service refuses to start otherwise; it never falls back to localhost.
# Only for a FreeLLMAPI running as a Railway service reached over Railway's private network:
# FREELLMAPI_BASE_URL=http://<service>.railway.internal:<port>/v1
# FREELLMAPI_ALLOW_RAILWAY_PRIVATE_HTTP=true

# Your FreeLLMAPI unified API key (FreeLLMAPI dashboard -> Keys). Never commit it.
FREELLMAPI_API_KEY=
# auto (the router picks) | auto:<profile> e.g. auto:fast | any model id listed by /v1/models
FREELLMAPI_MODEL=auto
# Set true only if your gateway supports OpenAI's stream_options (token usage while streaming).
FREELLMAPI_STREAM_USAGE=false

# Timeouts and bounded retries (429/5xx/connection failures only).
LLM_TIMEOUT_SECONDS=90
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_MAX_BACKOFF_SECONDS=8
LOG_LEVEL=INFO
