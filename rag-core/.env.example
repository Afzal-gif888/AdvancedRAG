# AdvancedRAG RAG Core — copy to rag-core/.env. Owns the Pinecone key. No embedding API key:
# embeddings are computed locally inside this service.

ENVIRONMENT=development
INTERNAL_SERVICE_TOKEN=

# RAG Core's own PostgreSQL database (chunk text + full-text keyword index).
DATABASE_URL=postgresql+asyncpg://advancerag:CHANGE_ME@127.0.0.1:5434/advancerag_rag

# Local embeddings (fastembed, ONNX on CPU). The model is downloaded once (~70 MB) into
# EMBEDDING_CACHE_DIR on first start. Documents and queries use the same model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional guard. If set it must equal the model's real output dimension (bge-small: 384),
# otherwise RAG Core refuses to start.
EMBEDDING_DIMENSIONS=
EMBEDDING_CACHE_DIR=var/models
EMBEDDING_BATCH_SIZE=32
# A document becomes ready only after its vectors read back from the store (bounded wait).
INGEST_VERIFY_SECONDS=20
# Stored CSV tables for exact statistics (larger CSVs are still indexed as text).
TABLE_MAX_ROWS=200000
TABLE_MAX_COLUMNS=100

# Vector store. Create a *serverless* Pinecone index with:
#   dimension = 384  (the output of BAAI/bge-small-en-v1.5)
#   metric    = cosine
# at https://app.pinecone.io. A mismatched index is reported by /ready and writes are refused.
# Changing EMBEDDING_MODEL later requires a new index with the new dimension + re-ingesting.
VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=

# Reranking via Pinecone hosted inference (same Pinecone key; "none" keeps the RRF order).
RERANKER=pinecone
RERANK_MODEL=bge-reranker-v2-m3

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=12000
LOG_LEVEL=INFO
